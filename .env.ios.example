# Copy to `.env.ios` and set your iOS backend URL here.
# This is used by `npm run build:ios` and `npm run cap:sync:ios`.
VITE_IOS_API_BASE_URL=https://api.example.com

# App Store Connect one-time, non-consumable product IDs.
VITE_VIP_PRODUCT_ID=com.georgicole.thebigeye.vip
# VIP upgrade tiers used when owned standalone products earn 75% credit.
VITE_VIP_UPGRADE_1349_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade1349
VITE_VIP_UPGRADE_1299_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade1299
VITE_VIP_UPGRADE_1199_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade1199
VITE_VIP_UPGRADE_1099_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade1099
VITE_VIP_UPGRADE_999_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade999
VITE_VIP_UPGRADE_899_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade899
VITE_VIP_UPGRADE_799_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade799
VITE_VIP_UPGRADE_699_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade699
VITE_VIP_UPGRADE_599_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade599
VITE_VIP_UPGRADE_499_PRODUCT_ID=com.georgicole.thebigeye.vip.upgrade499
VITE_SURVIVAL_MODE_PRODUCT_ID=com.georgicole.thebigeye.survival
VITE_PUBLIC_MODE_PRODUCT_ID=com.georgicole.thebigeye.publicmode
VITE_TRIBUNAL_HOUSE_PRODUCT_ID=com.georgicole.thebigeye.tribunalhouse
VITE_DRAMA_MODE_PRODUCT_ID=com.georgicole.thebigeye.dramamode
VITE_CUPID_ARROW_PRODUCT_ID=com.georgicole.thebigeye.cupidarrow
VITE_VOX_POPULI_PRODUCT_ID=com.georgicole.thebigeye.voxpopuli
VITE_NO_ADS_PRODUCT_ID=com.georgicole.thebigeye.noads

# Optional online services. Leave disabled/unset for the offline-first release.
# VITE_BIG_EYE_AI_ENABLED=true
# VITE_BIG_EYE_VIP_API_URL=https://api.example.com

# Public store/support pages hosted separately so the game repository can be private.
VITE_PRIVACY_POLICY_URL=https://georgi-cole.github.io/big-eye-legal/privacy-policy.html
VITE_TERMS_URL=https://georgi-cole.github.io/big-eye-legal/terms-of-use.html
VITE_SUPPORT_URL=https://georgi-cole.github.io/big-eye-legal/support.html
