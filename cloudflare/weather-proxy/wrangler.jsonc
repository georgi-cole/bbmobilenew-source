{
  "$schema": "../vip-confessional/node_modules/wrangler/config-schema.json",
  "name": "the-big-eye-weather-proxy",
  "account_id": "9274d7feb04a88cdd6f9d40d8ca197af",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false,
    },
    "traces": {
      "enabled": false,
    },
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://georgi-cole.github.io,https://localhost,capacitor://localhost,http://localhost:5173,http://localhost:5174",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WEATHER_CACHE",
        "class_name": "WeatherCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WeatherCache"],
    },
  ],
}
